<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.library.agent.mapper.ToolCallRecordMapper">

    <resultMap id="ToolCallRecordResultMap" type="com.library.agent.entity.ToolCallRecord">
        <id property="id" column="id"/>
        <result property="traceId" column="trace_id"/>
        <result property="callSequence" column="call_sequence"/>
        <result property="toolName" column="tool_name"/>
        <result property="toolInput" column="tool_input"/>
        <result property="toolOutput" column="tool_output"/>
        <result property="success" column="success"/>
        <result property="durationMs" column="duration_ms"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.library.agent.entity.ToolCallRecord"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO agent_tool_call_record
        (
            trace_id,
            call_sequence,
            tool_name,
            tool_input,
            tool_output,
            success,
            duration_ms,
            created_at
        )
        VALUES
        (
            #{traceId},
            #{callSequence},
            #{toolName},
            #{toolInput},
            #{toolOutput},
            COALESCE(#{success}, TRUE),
            #{durationMs},
            COALESCE(#{createdAt}, CURRENT_TIMESTAMP)
        )
    </insert>

    <select id="selectByTraceId" resultMap="ToolCallRecordResultMap">
        SELECT *
        FROM agent_tool_call_record
        WHERE trace_id = #{traceId}
        ORDER BY call_sequence ASC
    </select>

</mapper>
