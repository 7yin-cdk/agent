<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.library.agent.mapper.ConversationTraceMapper">

    <resultMap id="ConversationTraceResultMap" type="com.library.agent.entity.ConversationTrace">
        <id property="id" column="id"/>
        <result property="traceId" column="trace_id"/>
        <result property="userId" column="user_id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="userQuery" column="user_query"/>
        <result property="intentType" column="intent_type"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="totalDurationMs" column="total_duration_ms"/>
        <result property="totalInputTokens" column="total_input_tokens"/>
        <result property="totalOutputTokens" column="total_output_tokens"/>
        <result property="totalTokens" column="total_tokens"/>
        <result property="llmCallCount" column="llm_call_count"/>
        <result property="toolCallCount" column="tool_call_count"/>
        <result property="status" column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.library.agent.entity.ConversationTrace"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO agent_conversation_trace
        (
            trace_id,
            user_id,
            conversation_id,
            user_query,
            intent_type,
            start_time,
            end_time,
            total_duration_ms,
            total_input_tokens,
            total_output_tokens,
            total_tokens,
            llm_call_count,
            tool_call_count,
            status,
            error_message,
            created_at
        )
        VALUES
        (
            #{traceId},
            #{userId},
            #{conversationId},
            #{userQuery},
            #{intentType},
            #{startTime},
            #{endTime},
            #{totalDurationMs},
            COALESCE(#{totalInputTokens}, 0),
            COALESCE(#{totalOutputTokens}, 0),
            COALESCE(#{totalTokens}, 0),
            COALESCE(#{llmCallCount}, 0),
            COALESCE(#{toolCallCount}, 0),
            COALESCE(#{status}, 'SUCCESS'),
            #{errorMessage},
            COALESCE(#{createdAt}, CURRENT_TIMESTAMP)
        )
    </insert>

    <select id="selectByUserId" resultMap="ConversationTraceResultMap">
        SELECT *
        FROM agent_conversation_trace
        WHERE user_id = #{userId}
        ORDER BY created_at DESC
    </select>

    <select id="selectByTraceId" resultMap="ConversationTraceResultMap">
        SELECT *
        FROM agent_conversation_trace
        WHERE trace_id = #{traceId}
    </select>

</mapper>
