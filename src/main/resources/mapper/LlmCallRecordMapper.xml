<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.library.agent.mapper.LlmCallRecordMapper">

    <resultMap id="LlmCallRecordResultMap" type="com.library.agent.entity.LlmCallRecord">
        <id property="id" column="id"/>
        <result property="traceId" column="trace_id"/>
        <result property="callSequence" column="call_sequence"/>
        <result property="modelName" column="model_name"/>
        <result property="callType" column="call_type"/>
        <result property="inputPrompt" column="input_prompt"/>
        <result property="outputResponse" column="output_response"/>
        <result property="inputTokens" column="input_tokens"/>
        <result property="outputTokens" column="output_tokens"/>
        <result property="durationMs" column="duration_ms"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert"
            parameterType="com.library.agent.entity.LlmCallRecord"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO agent_llm_call_record
        (
            trace_id,
            call_sequence,
            model_name,
            call_type,
            input_prompt,
            output_response,
            input_tokens,
            output_tokens,
            duration_ms,
            created_at
        )
        VALUES
        (
            #{traceId},
            #{callSequence},
            #{modelName},
            #{callType},
            #{inputPrompt},
            #{outputResponse},
            COALESCE(#{inputTokens}, 0),
            COALESCE(#{outputTokens}, 0),
            #{durationMs},
            COALESCE(#{createdAt}, CURRENT_TIMESTAMP)
        )
    </insert>

    <select id="selectByTraceId" resultMap="LlmCallRecordResultMap">
        SELECT *
        FROM agent_llm_call_record
        WHERE trace_id = #{traceId}
        ORDER BY call_sequence ASC
    </select>

</mapper>
